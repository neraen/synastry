{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "_disabled",
    "compat-v2",
    "dist",
    "example",
    "miroir-v2",
    "node_modules",
    "refonte-miroir",
    "screens",
    "theme-astral",
    "theme-natal-native"
  ]
}
